{
  "name": "discord-bot-mcp",
  "version": "0.1.0",
  "description": "A minimal local MCP server for reading and sending Discord messages with a bot.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/laurens-pilot/discord_bot_mcp.git"
  },
  "scripts": {
    "setup": "node src/cli.mjs setup",
    "start": "node src/cli.mjs",
    "doctor": "node src/cli.mjs doctor",
    "test": "node --test",
    "format": "prettier --write .",
    "check": "prettier --check . && eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.4.0",
    "prettier": "3.9.9"
  }
}
